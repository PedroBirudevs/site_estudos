# Copie para .env.local e preencha. Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# Chave da API do Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase: Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Senha para entrar no site (ele fica público na Vercel e cada resumo gasta créditos da API)
APP_PASSWORD=

# Opcional: modelo do Gemini (padrão: gemini-3.8-flash)
GEMINI_MODEL=
